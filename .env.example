# Anthropic key. Deliberately not named ANTHROPIC_API_KEY (the Claude Code cloud env strips that name).
APP_ANTHROPIC_API_KEY=
# Password for /staff
STAFF_PASSWORD=habitat2026
# Local dev: SQLite file
DATABASE_URL="file:./dev.db"
# Vercel/production: Turso (libSQL). When set, the app uses Turso instead of the SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 to return fixtures instead of calling Claude (e2e)
MOCK_CLAUDE=0
